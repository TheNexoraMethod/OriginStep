{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "app",
    "src",
    "assets",
    "*.ts",
    "*.tsx",
    "*.js",
    ".expo/types/**/*.d.ts",
    "expo-env.d.ts"
  ]
}
